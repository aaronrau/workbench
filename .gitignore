# Captured speech, transcripts, and agent messages. These are the durable
# app-private and shared-folder artifacts; a copy pulled into the working tree
# for inspection must never become a commit.
*.raw.txt
*.corrected.txt
*.message.txt
*.conversation.txt
*.continuous.txt
*.transcript.json
*.correction-skipped.json
pending-corrections.json

# Voice signatures and the local history index, including SQLite sidecars.
# The speaker profile bank is the most sensitive file the app writes.
*.wbprofiles
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-wal
*.db-shm

# Shared-folder recovery documents mirrored from private configuration.
workbench-correction-prompt.txt
workbench-agent-servers.json
workbench-speaker-signatures.*
workbench-history-cache-*

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# App-bundled development models remain local. The external Parakeet models
# used by the Android staging tool live under /models/stt and use Git LFS.
# Gemma is split into Git LFS chunks under /models/llm so each object remains
# compatible with hosted LFS file-size limits.
/assets/models/**/*.onnx
/assets/models/**/*.bin
/assets/models/whisper/tiny.en-tokens.txt
*.litertlm
